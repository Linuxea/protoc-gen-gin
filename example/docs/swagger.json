                    "application/json"
                ],
                "tags": [
                    "NotificationService"
                ],
                "summary": "Send",
                "operationId": "user.v1.NotificationService.Send",
                "parameters": [
                    {
                        "description": "Send request body",
                        "name": "request",
                        "in": "body",
                        "required": true,
